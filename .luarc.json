{
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": true,
    "special": {
      "love.filesystem.load": "loadfile"
    }
  },
  "diagnostics": {
    "disable": ["duplicate-set-field"],
    "libraryFiles": "Disable",
    "neededFileStatus": {
      "global-element": "Any",
      "incomplete-signature-doc": "Any",
      "missing-global-doc": "Any",
      "missing-local-export-doc": "Any",
      "not-yieldable": "Any"
    }
  },
  "type": {
    "castNumberToInteger": false,
    "weakUnionCheck": false,
    "weakNilCheck": false,
    "inferParamType": true,
    "checkTableShape": true,
    "inferTableSize": 100
  },
  "workspace": {
    "checkThirdParty": false,
    "useGitIgnore": true,
    "library": ["vendor/love2d-types"],
    "ignoreDir": [
      ".cache",
      ".git",
      ".claude",
      ".agents",
      "log",
      "tmp",
      "data/scripts/overrides",
      "vendor",
      ".worktrees"
    ]
  }
}
