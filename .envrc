# Local development environment (direnv). Run `direnv allow` once to load it;
# the scripts in scripts/ also source this file directly, so direnv is optional.
#
# PORTEMON_SAVE_DIR overrides where LÖVE writes its private cache. Pointing it at
# a gitignored in-repo folder keeps ROM-derived data out of $HOME during dev and
# is the same single knob a future portable mode will use. Unset it to fall back
# to the OS default per-user save directory.
export PORTEMON_SAVE_DIR="$PWD/.cache"
